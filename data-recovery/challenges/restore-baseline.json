{
  "name": "restore-baseline",
  "description": "Load a Rally corpus into a source index or data stream, obtain a recovery point, restore it with mode rename and validate the restored index against the source",
  "default": true,
  "schedule": [
    {
      "name": "preflight",
      "operation": {
        "operation-type": "data-recovery-preflight",
        "source_index": "{{ p_source.target }}",
        "restore_prefix": "{{ restore_prefix | default('rally-restore-') }}"
      }
    },
    {
      "name": "delete-source",
      "operation": {
        "operation-type": "{{ 'delete-data-stream' if p_is_data_stream else 'delete-index' }}"
      }
    },
    {
      "name": "create-source",
      "operation": {
        "operation-type": "{{ 'create-data-stream' if p_is_data_stream else 'create-index' }}"
      }
    },
    {
      "name": "index-source",
      "operation": {
        "operation-type": "bulk",
        "corpora": "{{ p_corpus }}",
        "bulk-size": {{ bulk_size | default(5000) }},
        "ingest-percentage": {{ ingest_percentage | default(100) }}
      },
      "clients": {{ bulk_indexing_clients | default(8) }}
    },
    {
      "name": "refresh-source",
      "operation": {
        "operation-type": "refresh",
        "index": "{{ p_source.target }}"
      }
    },
    {
      "name": "record-source",
      "operation": {
        "operation-type": "record-source",
        "index": "{{ p_source.target }}",
        "target_type": "{{ p_source.target_type }}",
        "checksum_field": {{ (p_source.checksum_field if validate_restore | default(true) else none) | tojson }}
      }
    },
    {
      "name": "wait-for-recovery-point",
      "operation": {
        "operation-type": "wait-for-recovery-point",
        "recovery_point_mode": "{{ recovery_point_mode | default('wait') }}",
        "recovery_repo": "{{ recovery_repo | default('data-recovery') }}",
        "timeout_secs": {{ recovery_point_timeout_secs | default(2400) }},
        "poll_interval_secs": {{ poll_interval_secs | default(10) }}
      }
    },
    {
      "name": "restore-recovery",
      "operation": {
        "operation-type": "restore-recovery",
        "restore_prefix": "{{ restore_prefix | default('rally-restore-') }}",
        "timeout_secs": {{ recovery_timeout_secs | default(600) }},
        "poll_interval_secs": {{ restore_poll_interval_secs | default(2) }},
        "use_status_api": {{ use_status_api | default(false) | tojson }}
      }
    }
    {#- validate-restore and cleanup-recovery are left out when switched off: Rally fails a task whose runner makes no Elasticsearch request. -#}
    {% if validate_restore | default(true) -%}
    ,
    {
      "name": "validate-restore",
      "operation": {
        "operation-type": "validate-restore"
      }
    }
    {%- endif %}
    {% if cleanup | default(true) -%}
    ,
    {
      "name": "cleanup-recovery",
      "operation": {
        "operation-type": "cleanup-recovery"
      }
    }
    {%- endif %}
  ]
}
