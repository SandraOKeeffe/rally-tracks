{% import "rally.helpers" as rally with context -%}
{
  "version": 2,
  "description": "Benchmarks Serverless data recovery restores (duration at normal size and at platform limits) and verifies restores grow cluster state like normal index creation. Only restore-baseline is implemented; see README.md.",
  "parameters": {
    "source_index": "recovery-source",
    "doc_count": 100,
    "recovery_point_mode": "wait",
    "recovery_repo": "data-recovery",
    "restore_prefix": "rally-restore-",
    "recovery_point_max_age_minutes": 60,
    "fail_on_recovery_failure": true,
    "state_tolerance": 0.1,
    "step_size": 10,
    "max_sources": 100
  },
  "challenges": [
    {{ rally.collect(parts="challenges/*.json") }}
  ]
}
