{
  "name": "max-concurrent-restores-many-shards",
  "description": "SKELETON: run the maximum concurrent restores with many shards each, exercising the cluster state limit",
  "default": false,
  "schedule": [
    {
      "name": "preflight",
      "operation": {
        "operation-type": "data-recovery-preflight"
      }
    },
    {
      "name": "wait-for-recovery-point",
      "operation": {
        "operation-type": "wait-for-recovery-point"
      }
    },
    {
      "name": "restore-recovery",
      "operation": {
        "operation-type": "restore-recovery"
      }
    }
  ]
}
